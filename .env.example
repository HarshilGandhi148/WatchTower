# Backend-only settings. Copy to .env; never commit real credentials.
APP_MODE=live
AIRPORT_ICAO=KDTW
AIRPORT_IATA=DTW
AIRPORT_LATITUDE_DEG=42.2124311
AIRPORT_LONGITUDE_DEG=-83.3533933
DISPLAY_TIMEZONE=America/Detroit
TRAFFIC_RADIUS_NM=40
PROJECTION_HORIZON_MIN=15

# Tested local persistence module: CLI/server/SDK 2.10.2.
SPACETIMEDB_HTTP_URL=http://127.0.0.1:3000
SPACETIMEDB_WS_URL=ws://127.0.0.1:3000
SPACETIMEDB_DATABASE=watchtower-local
SPACETIMEDB_INGEST_TOKEN=
SPACETIMEDB_WEATHER_TOKEN=
SPACETIMEDB_CONGESTION_TOKEN=
SPACETIMEDB_VALIDATION_TOKEN=

WEATHER_AGENT_SEED=
CONGESTION_AGENT_SEED=
# Private and fixed; changing it changes the validator's address and mailbox.
VALIDATION_AGENT_SEED=
# Local port when the validator runs alone (python -m agents.validation.agent).
VALIDATION_AGENT_PORT=8002
AGENT_DEPLOYMENT_MODE=local
# Fill after registering the three separate identities.
WEATHER_AGENT_ADDRESS=
CONGESTION_AGENT_ADDRESS=
VALIDATION_AGENT_ADDRESS=

# Optional: enables model-phrased answers in the validator's read-only ASI:One chat.
# Without it, the chat replies with a deterministic summary of validated advisories.
ASI_ONE_API_KEY=
ASI_ONE_BASE_URL=https://api.asi1.ai/v1
ASI_ONE_MODEL=asi1

AWC_BASE_URL=https://aviationweather.gov/api/data
ADSB_BASE_URL=https://api.adsb.lol
FAA_STATUS_URL=https://nasstatus.faa.gov/api/airport-status-information
DATA_USER_AGENT=DTW-Hackathon/<version> (<team-contact>)

ENABLE_FLIGHTAWARE=false
FLIGHTAWARE_API_KEY=
FLIGHTAWARE_BASE_URL=https://aeroapi.flightaware.com/aeroapi
FLIGHTAWARE_BUDGET_USD=
# Price of one AeroAPI result set (15 records) for the endpoints used, from the portal.
FLIGHTAWARE_COST_PER_RESULT_SET_USD=
FLIGHTAWARE_MAX_PAGES=1
# Demo departure capacity (aircraft/hour), 6-120; empty disables projections.
DEPARTURE_CAPACITY_PER_HOUR=
# Optional fallback initial departure backlog (aircraft), both or neither. Used only when
# stored flight records lack gate times; labelled operator-configured and limits quality.
DEPARTURE_BACKLOG_UPSTREAM=
DEPARTURE_BACKLOG_RUNWAY_QUEUE=

ENABLE_NWS=false
ENABLE_OPENSKY=false
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
