{
  "name": "watchtower-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check . --ignore-path ../.prettierignore",
    "format": "prettier --write . --ignore-path ../.prettierignore",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
    "dev:test": "vite --config tests/vite.config.ts",
    "build:demo": "vite build --config tests/vite.config.ts --base=/demo/"
  },
  "dependencies": {
    "maplibre-gl": "6.12.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "spacetimedb": "2.10.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^16.0.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
